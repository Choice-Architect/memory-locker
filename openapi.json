{
  "openapi": "3.1.0",
  "info": {
    "title": "Memory Locker Action",
    "version": "1.5",
    "description": "Stores or retrieves text memories with extracted entities, using vector search, FTS fallback, and application-layer re-ranking. Date handling focuses on extracting components."
  },
  "x-oai-openapi": "1.0",
  "x-oai-openai-integration": {
    "authentication": {
      "type": "api_key",
      "key_name": "x-api-key",
      "location": "header"
    }
  },
  "servers": [
    {
      "url": "https://memory-locker-gpt.netlify.app",
      "description": "Netlify Site Root"
    }
  ],
  "paths": {
    "/.netlify/functions/memory-action": {
      "post": {
        "summary": "Store or query memories with entity extraction",
        "description": "Handles storing text/entities (extracting date components, embedding) and querying memories. Store Mode: Processes, extracts, embeds, saves info. Query Mode: Embeds query, performs vector search + FTS fallback, re-ranks results using similarity/rank/metadata/dates, returns relevant context.",
        "operationId": "memoryAction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request (e.g., invalid input, missing required fields)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (Invalid API Key)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RequestPayload": {
        "type": "object",
        "required": [
          "query_text",
          "extracted_entities",
          "mode"
        ],
        "properties": {
          "query_text": {
            "type": "string",
            "description": "The primary text content provided by the user."
          },
          "extracted_entities": {
            "$ref": "#/components/schemas/ExtractedEntities"
          },
          "mode": {
            "type": "string",
            "enum": [
              "store",
              "query"
            ],
            "description": "Operation mode: 'store' only saves, 'query' only searches. Combined intents are handled by sequential store/query calls."
          }
        }
      },
      "ExtractedEntities": {
        "type": "object",
        "description": "Entities potentially extracted by the GPT before sending to the action. Dates will be re-processed into EnhancedNormalizedDate components by the action.",
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dates": {
            "type": "array",
            "description": "Dates extracted by the GPT. Can be strings or objects with 'original' and optional 'normalized'. The action will parse these into EnhancedNormalizedDate components.",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "A natural language date string (e.g., \"next Tuesday\") or potentially other formats."
                },
                {
                  "type": "object",
                  "properties": {
                    "original": {
                      "type": "string",
                      "description": "The original date string extracted by the GPT."
                    },
                    "normalized": {
                      "type": "string",
                      "description": "Optional normalized date in 'Month DD, YYYY' format provided by the GPT."
                    }
                  },
                  "required": ["original"]
                }
              ]
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string",
            "description": "Inferred type/category of the memory (e.g., meeting, note, reminder)."
          },
          "sentiment": {
            "type": "string",
            "description": "Inferred sentiment (e.g., positive, negative, neutral)."
          },
          "priority": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 10,
            "description": "User-defined priority (1-10)."
          },
          "conversation_id": {
            "type": "string",
            "description": "Optional ID linking related memories or conversations."
          },
          "thread_id": {
            "type": "string",
            "description": "Optional ID linking related threads within a conversation."
          },
          "language": {
            "type": "string",
            "description": "Detected language of the query_text (e.g., 'en', 'fr'). Used for FTS config, excluded from FTS query terms & metadata boost."
          },
          "organizations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extracted organization names."
          }
        },
        "additionalProperties": true
      },
      "ProcessedEntities": {
        "type": "object",
        "description": "Entities after processing by the action, stored in metadata and returned in context. Uses EnhancedNormalizedDate for dates.",
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnhancedNormalizedDate"
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organizations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extracted organization names."
          },
          "type": {
            "type": "string"
          },
          "sentiment": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 10
          },
          "conversation_id": {
            "type": "string"
          },
          "thread_id": {
            "type": "string"
          },
          "language": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "EnhancedNormalizedDate": {
        "type": "object",
        "description": "Enhanced date object containing extracted components derived by the action.",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32",
            "description": "Extracted year (e.g., 2024)."
          },
          "month": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 12,
            "description": "Extracted month (1-12)."
          },
          "day": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 31,
            "description": "Extracted day of the month (1-31)."
          },
          "day_of_week": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 6,
            "description": "Extracted day of the week (0=Sun, 1=Mon...)."
          },
          "week_number": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 53,
            "description": "Extracted ISO 8601 week number (1-53)."
          },
          "period": {
            "type": "string",
            "enum": [
              "Morning",
              "Afternoon",
              "Evening",
              "Night"
            ],
            "description": "Inferred period of day (Morning, Afternoon, Evening, Night)."
          },
          "organizations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extracted organization names."
          }
        }
      },
      "ContextObject": {
        "type": "object",
        "properties": {
          "chunk": {
            "type": "string",
            "description": "The relevant text chunk retrieved (or truncated file text for FTS fallback)."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of chunk/file creation."
          },
          "entities_in_chunk": {
            "$ref": "#/components/schemas/ProcessedEntities"
          },
          "file_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID of the source file."
          },
          "chunk_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID of the specific chunk (from vector search)."
          },
          "chunk_index": {
            "type": "integer",
            "format": "int32",
            "description": "Index of the chunk within its file (from vector search)."
          },
          "similarity": {
            "type": "number",
            "format": "float",
            "description": "Vector similarity score (from vector search)."
          },
          "rank": {
            "type": "number",
            "format": "float",
            "description": "FTS rank score (from FTS fallback)."
          }
        },
        "required": [
          "chunk",
          "timestamp",
          "entities_in_chunk"
        ]
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "retrieved_context": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContextObject"
            }
          },
          "storage_status": {
            "type": "string",
            "description": "Status of the storage operation (e.g., 'Stored successfully', 'Storage skipped', 'Storage failed', 'No storage operation requested')."
          },
          "query_source": {
            "type": "string",
            "enum": [
              "hybrid",
              "none",
              "error"
            ],
            "description": "Indicates the primary source of the retrieved context (vector, FTS text, hybrid combination) or if none was found/an error occurred."
          },
          "message_for_gpt": {
            "type": "string",
            "description": "Optional message providing additional context or status to the GPT (e.g., fallback reason, error details)."
          },
          "error": {
            "type": "null"
          }
        },
        "required": [
          "retrieved_context",
          "storage_status",
          "query_source",
          "error"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Description of the error."
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
} 